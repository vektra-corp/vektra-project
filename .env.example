# =============================================================================
# Environment template — copy to apps/web/.env.local and apps/admin/.env.local
# NEVER commit real secrets. Production secrets live in Doppler (claude.md §13.10)
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Development runs against a hosted Supabase project (Settings > API).
#
#   URL  and ANON KEY are public by design — the anon key ships in the browser
#   bundle and is useless without a valid session, because RLS is the boundary.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

#   SERVICE ROLE KEY bypasses RLS completely and can read every tenant's data.
#   Treat it like a root password: server-side only, never in a NEXT_PUBLIC_
#   variable, never committed, rotate it if it is ever pasted somewhere shared.
SUPABASE_SERVICE_ROLE_KEY=

#   Direct Postgres connection, used only by migrations, seeding and the RLS
#   test suite. Settings > Database > Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Optional. Migrations need PREPARED STATEMENTS, which Supavisor's transaction
# pooler (port 6543) does not support — `supabase db push` fails there with
# SQLSTATE 42P05. Leave this unset and the db:* scripts derive a session-mode
# URL by swapping 6543 -> 5432; set it explicitly to use a direct connection.
SUPABASE_MIGRATION_DB_URL=

# --- App URLs (used for CSRF origin checks, links in emails) -------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# --- Stripe -------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply-projects@vektracorp.in

# --- Background jobs (Inngest) ------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Cache / rate limiting (Upstash Redis) ------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Integrations (§12) -------------------------------------------------------
# Slack OAuth. Create an app at api.slack.com/apps, add the redirect URL
# <APP_URL>/api/integrations/slack/callback, and request the bot scopes
# chat:write, chat:write.public and channels:read. Without these the
# integrations page says so plainly and the connect button is not offered.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Symmetric key for integration OAuth tokens at rest (§13.10). Tokens are
# encrypted inside Postgres with pgcrypto; this key is passed in per call and is
# never stored beside the ciphertext it protects.
#
#   openssl rand -base64 48
#
# Rotating it makes every stored token undecryptable — the dispatcher marks
# those integrations as errored and they have to be reconnected. There is no
# re-encryption path yet.
INTEGRATION_ENCRYPTION_KEY=

# --- Monitoring ---------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Admin portal -------------------------------------------------------------
# Comma-separated allowlist of admin email addresses
ADMIN_ALLOWED_EMAILS=
