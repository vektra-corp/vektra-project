# =============================================================================
# Environment template — copy to apps/web/.env.local and apps/admin/.env.local
# NEVER commit real secrets. Production secrets live in Doppler (claude.md §13.10)
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Development runs against a hosted Supabase project (Settings > API).
#
#   URL  and ANON KEY are public by design — the anon key ships in the browser
#   bundle and is useless without a valid session, because RLS is the boundary.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

#   SERVICE ROLE KEY bypasses RLS completely and can read every tenant's data.
#   Treat it like a root password: server-side only, never in a NEXT_PUBLIC_
#   variable, never committed, rotate it if it is ever pasted somewhere shared.
SUPABASE_SERVICE_ROLE_KEY=

#   Direct Postgres connection, used only by migrations, seeding and the RLS
#   test suite. Settings > Database > Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Optional. Migrations need PREPARED STATEMENTS, which Supavisor's transaction
# pooler (port 6543) does not support — `supabase db push` fails there with
# SQLSTATE 42P05. Leave this unset and the db:* scripts derive a session-mode
# URL by swapping 6543 -> 5432; set it explicitly to use a direct connection.
SUPABASE_MIGRATION_DB_URL=

# --- App URLs (used for CSRF origin checks, links in emails) -------------------
#
# Production:
#   NEXT_PUBLIC_APP_URL=https://projects.vektracorp.in
#   NEXT_PUBLIC_ADMIN_URL=https://admin.vektracorp.in/project
#
# The admin URL carries a path because that subdomain is shared across Vektra
# products. `isAllowedOrigin` normalises both sides before comparing, so the
# path does not break the CSRF origin check — an Origin header never has one.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Where the admin console is mounted. Defaults to /project; set it to an empty
# string only if the console ever gets a subdomain to itself.
NEXT_PUBLIC_ADMIN_BASE_PATH=/project

# --- Payments -----------------------------------------------------------------
# Two gateways, chosen by the organization's billing country and never by the
# customer: India -> Razorpay, everywhere else -> PayPal.

#   Razorpay. The key id is publishable and ships in the browser bundle for
#   Checkout; the secret and the webhook secret are server-only.
#   NOTE: Razorpay Subscriptions must be enabled on the account — it is not on
#   by default, and nothing works without it.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

#   PayPal. Leave PAYPAL_API_BASE unset to use sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

#   LOCAL DEVELOPMENT ONLY. Forces a gateway regardless of billing country, so
#   both paths can be exercised from one machine. Ignored outright when
#   NODE_ENV or VERCEL_ENV is production — see lib/payments/select.ts.
PAYMENTS_PROVIDER_OVERRIDE=

# --- Invoicing (Vektra Corporation) -------------------------------------------
# Printed on every invoice and used to decide the GST treatment. The seller
# state code must match the first two digits of the GSTIN.
BILLING_LEGAL_NAME=Vektra Corporation
BILLING_PARENT_ENTITY=ECappz Technology Private Limited
BILLING_SELLER_GSTIN=
BILLING_SELLER_STATE=
BILLING_SELLER_ADDRESS=
BILLING_SAC_CODE=998314
#   Letter of Undertaking, for zero-rated export invoices. Without a valid LUT
#   an export is lawfully charged IGST, which we would then have to reclaim.
BILLING_LUT_ARN=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply-projects@vektracorp.in

# --- Background jobs (Inngest) ------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Cache / rate limiting (Upstash Redis) ------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Integrations (§12) -------------------------------------------------------
# Slack OAuth. Create an app at api.slack.com/apps, add the redirect URL
# <APP_URL>/api/integrations/slack/callback, and request the bot scopes
# chat:write, chat:write.public and channels:read. Without these the
# integrations page says so plainly and the connect button is not offered.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Symmetric key for integration OAuth tokens at rest (§13.10). Tokens are
# encrypted inside Postgres with pgcrypto; this key is passed in per call and is
# never stored beside the ciphertext it protects.
#
#   openssl rand -base64 48
#
# Rotating it makes every stored token undecryptable — the dispatcher marks
# those integrations as errored and they have to be reconnected. There is no
# re-encryption path yet.
INTEGRATION_ENCRYPTION_KEY=

# --- Monitoring ---------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Admin portal -------------------------------------------------------------
# Comma-separated allowlist of admin email addresses
ADMIN_ALLOWED_EMAILS=
