{
  "name": "@pm/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./queries": "./src/queries/index.ts",
    "./helpers": "./src/helpers.ts"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "gen:types": "supabase gen types typescript --local > src/types.ts",
    "clean": "rm -rf .turbo dist *.tsbuildinfo"
  },
  "dependencies": {
    "@pm/shared": "workspace:*"
  },
  "devDependencies": {
    "@pm/eslint-config": "workspace:*",
    "@types/node": "^26.5.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@supabase/supabase-js": "^2.114.0"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.114.0"
  }
}
